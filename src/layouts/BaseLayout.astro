---
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/700.css';
import '@fontsource/nunito/800.css';
import '@fontsource/nunito/900.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, alternatePath } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  /** Set on the homepage to emit Person JSON-LD */
  isHome?: boolean;
  /** Absolute path of an OG image, e.g. /img/lukas.jpg */
  ogImage?: string;
}

const { title, description, isHome = false, ogImage } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const enUrl = new URL(alternatePath(Astro.url.pathname, 'en'), site);
const deUrl = new URL(alternatePath(Astro.url.pathname, 'de'), site);
const siteName = 'Lukas Ziegler';
const pageTitle = isHome ? `${siteName} — Product Designer & Handpan Facilitator` : `${title} · ${siteName}`;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lukas Ziegler',
  url: site.toString(),
  email: 'mailto:lukas@lukasziegler.com',
  jobTitle: 'Product Designer & Handpan Facilitator',
  sameAs: ['https://instagram.com/lukasziegler', 'https://linkedin.com/in/lukasziegler'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Salzburg',
    addressCountry: 'AT',
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, site)} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

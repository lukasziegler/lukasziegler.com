---
import type { CollectionEntry } from 'astro:content';
import { localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
}

const { project, lang } = Astro.props;
const slug = project.id.replace(/^(en|de)\//, '');
const href = localizePath(`/projects/${slug}/`, lang);
---

<article class="project">
  <a href={href} class="project-link">
    <img class="project-image" src={project.data.image} alt={project.data.title} loading="lazy" />
    <div class="project-info">
      <h3 class="project-title">{project.data.title}</h3>
      {project.data.subtitle && <div class="project-subtitle">{project.data.subtitle}</div>}
    </div>
  </a>
</article>

<style>
  .project-link {
    position: relative;
    display: block;
    aspect-ratio: 5 / 4;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-surface);
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-base);
  }

  .project-info {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-lg);
    text-align: center;
    color: #fff;
    background: rgb(18 15 62 / 0.45);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .project-link:hover,
  .project-link:focus-visible {
    .project-info {
      opacity: 1;
      backdrop-filter: blur(2px);
    }

    .project-image {
      transform: scale(1.03);
    }
  }

  .project-title {
    font-weight: var(--weight-black);
  }

  .project-subtitle {
    font-size: var(--text-sm);
    opacity: 0.85;
  }

  @media (hover: none) {
    .project-info {
      opacity: 1;
      background: linear-gradient(transparent 40%, rgb(18 15 62 / 0.75));
      justify-content: flex-end;
      text-align: start;
      align-items: flex-start;
    }
  }
</style>
